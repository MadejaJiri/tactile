+/*
+ * Who plays the click is feature report 0x21 of the actuator: 0 its firmware,
+ * 1 the host.
+ *
+ * The SPI actuator of the 14" M1 Pro (J314) leaves that report out of its
+ * descriptor and accepts it all the same, as a feature report. Going by the
+ * descriptor, apple_taptic_switch_modes() sends such an actuator nothing, and
+ * depending on its version reports success anyway; the firmware then plays
+ * its own click on top of the host's. So an SPI actuator that hides the
+ * report is written directly, and then asked which mode it is in: the
+ * transport does not wait for the firmware's answer to a SET, and a request
+ * the firmware refuses fails silently. One that refuses keeps its firmware
+ * click. Every other actuator goes through the helper as before.
+ */
+#define APPLE_TAPTIC_MODE_REPORT	0x21
+/* spi-hid-apple copies this much into the buffer of a GET, whatever was asked. */
+#define APPLE_SPI_REPLY_SIZE		512
+
+#define HAPTIC_MODE_IDLE_MS	250	/* no finger for this long: the pad is idle */
+#define HAPTIC_MODE_SETTLE_MS	1000	/* after probe, reset or resume */
+#define HAPTIC_MODE_RECHECK_MS	30000	/* ask the actuator again this often */
+#define HAPTIC_MODE_RETRIES	5
+
+static bool magicmouse_actuator_hides_mode(struct hid_device *actuator)
+{
+	const struct hid_report_enum *reports = actuator->report_enum;
+
+	return actuator->bus == BUS_SPI &&
+	       !reports[HID_FEATURE_REPORT].report_id_hash[APPLE_TAPTIC_MODE_REPORT] &&
+	       !reports[HID_OUTPUT_REPORT].report_id_hash[APPLE_TAPTIC_MODE_REPORT];
+}
+
+static int magicmouse_actuator_write_mode(struct hid_device *actuator, int mode)
+{
+	u8 *msg;
+	int ret;
+
+	if (!magicmouse_actuator_hides_mode(actuator))
+		return apple_taptic_switch_modes(actuator, mode);
+
+	msg = kzalloc(2, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	msg[0] = APPLE_TAPTIC_MODE_REPORT;
+	msg[1] = mode == HID_HAPTIC_MODE_HOST;
+	ret = hid_hw_raw_request(actuator, msg[0], msg, 2, HID_FEATURE_REPORT,
+				 HID_REQ_SET_REPORT);
+	kfree(msg);
+
+	return ret < 0 ? ret : 0;
+}
+
+/* The mode an actuator that hides the report says it is in, or an error. */
+static int magicmouse_actuator_read_mode(struct hid_device *actuator)
+{
+	u8 *buf;
+	int ret;
+
+	buf = kzalloc(APPLE_SPI_REPLY_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	ret = hid_hw_raw_request(actuator, APPLE_TAPTIC_MODE_REPORT, buf,
+				 APPLE_SPI_REPLY_SIZE, HID_FEATURE_REPORT,
+				 HID_REQ_GET_REPORT);
+	if (ret >= 2 && buf[0] == APPLE_TAPTIC_MODE_REPORT)
+		ret = buf[1] ? HID_HAPTIC_MODE_HOST : HID_HAPTIC_MODE_DEVICE;
+	else if (ret >= 0)
+		ret = -EPROTO;
+	kfree(buf);
+
+	return ret;
+}
+
+/*
+ * Set the mode and make sure of it. The J314 actuator shows the new mode in
+ * the very next read, a few milliseconds later; one that still reads back
+ * another mode, or nothing, after a second look has refused.
+ */
+static int magicmouse_actuator_set_mode(struct hid_device *actuator, int mode)
+{
+	int ret, tries;
+
+	ret = magicmouse_actuator_write_mode(actuator, mode);
+	if (ret || !magicmouse_actuator_hides_mode(actuator))
+		return ret;
+
+	for (tries = 0; tries < 2; tries++) {
+		msleep(tries ? 200 : 20);
+		ret = magicmouse_actuator_read_mode(actuator);
+		if (ret == mode)
+			return 0;
+	}
+
+	return ret < 0 ? ret : -EIO;
+}
