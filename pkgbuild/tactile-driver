#!/bin/bash
# tactile-driver: which hid-magicmouse is in use, and switching it without a reboot.
#
#   tactile-driver status     what is installed, what is loaded
#   tactile-driver reload     load the installed driver now (root)
#   tactile-driver stock      the kernel's own driver until the next boot (root)
#   tactile-driver repair     find the actuator again if it is missing (root)
#
# The actuator is the part under the trackpad that makes the click. On some
# boots the controller does not list it, and then only the trackpad's firmware
# can play the click. Probing the controller again brings it back; `repair`
# does that. It pauses keyboard and trackpad for two seconds, and it once
# froze the whole machine for four minutes instead, so save your work first.
#
# A reboot does the same as `reload`: Tactile's driver is the one the system
# loads once DKMS has built it. Switching by hand pauses the keyboard and the
# trackpad for about two seconds, because both hang off one SPI device that
# has to be probed again.
set -euo pipefail

KERNEL="$(uname -r)"
PARAMETERS=/sys/module/hid_magicmouse/parameters
SPI=/sys/bus/spi/drivers/spi-hid-apple-of
ACTUATOR=/sys/bus/hid/drivers/hid-apple-mtp-haptic
# The kernel's own driver. While Tactile's is installed, DKMS keeps it in its
# archive and puts it back when Tactile is removed.
STOCK="$(ls "/lib/modules/$KERNEL/kernel/drivers/hid/"hid-magicmouse.ko* \
	"/var/lib/dkms/tactile/original_module/$KERNEL"/*/hid-magicmouse.ko* \
	2>/dev/null | head -n 1 || true)"

installed() {
	modinfo -k "$KERNEL" -F filename hid_magicmouse 2>/dev/null || true
}

spi_device() {
	[ -d "$SPI" ] || return 0
	ls "$SPI" | grep -m1 -E '^spi[0-9]+\.[0-9]+$' || true
}

# The actuator is its own HID device beside the trackpad, with its own driver.
has_actuator() {
	ls "$ACTUATOR" 2>/dev/null | grep -q -E '^[0-9A-F]{4}:'
}

# Probe the SPI device again, so the driver starts from a freshly reset
# controller. The keyboard is on the same device: whatever happens next, bind
# it again.
rebind() {
	local device="$1"
	trap 'echo "$device" >"$SPI/bind" 2>/dev/null || true' EXIT
	echo "$device" >"$SPI/unbind"
	sleep 2
	echo "$device" >"$SPI/bind"
	trap - EXIT
}

# The patched driver is told from the kernel's own by an option only it has.
running() {
	if [ ! -d /sys/module/hid_magicmouse ]; then
		echo none
	elif [ -e "$PARAMETERS/haptic_debounce_ms" ]; then
		echo tactile
	else
		echo stock
	fi
}

status() {
	local file have="" runs=""
	file="$(installed)"
	case "$file" in
	*/updates/*)
		have="$(modinfo -F version "$file" 2>/dev/null || true)"
		echo "installed  Tactile's driver ${have:+$have }($file)"
		;;
	"") echo "installed  no hid-magicmouse for kernel $KERNEL" ;;
	*) echo "installed  the kernel's own driver only ($file)" ;;
	esac
	case "$(running)" in
	tactile)
		runs="$(cat /sys/module/hid_magicmouse/version 2>/dev/null || true)"
		if [ -n "$have" ] && [ "$runs" != "$have" ]; then
			echo "running    Tactile's driver ${runs:-(loaded by hand)}; the installed one takes over at the next boot, or with: sudo tactile-driver reload"
		else
			echo "running    Tactile's driver${runs:+ $runs}"
		fi
		;;
	stock)
		case "$file" in
		*/updates/*) echo "running    the kernel's own driver; Tactile's takes over at the next boot, or with: sudo tactile-driver reload" ;;
		*) echo "running    the kernel's own driver" ;;
		esac
		;;
	none) echo "running    hid-magicmouse is not loaded" ;;
	esac
	if [ -n "$(spi_device)" ] && ! has_actuator; then
		echo "actuator   not found at this boot, so the firmware plays the click (see: tactile-driver help)"
	fi
	if command -v dkms >/dev/null 2>&1; then
		echo "dkms       $(dkms status tactile 2>/dev/null | tr '\n' ';' | sed 's/;$//; s/;/; /g')"
	fi
	if systemctl is-active --quiet tactiled.service 2>/dev/null; then
		echo "service    running"
	else
		echo "service    not running (sudo systemctl enable --now tactiled)"
	fi
}

need_root() {
	if [ "$(id -u)" != 0 ]; then
		echo "tactile-driver: this needs root: sudo tactile-driver $1" >&2
		exit 1
	fi
}

# Everything the kernel logs after the mark belongs to this run.
MARK="tactile-driver $$-$(date +%s)"
since_mark() {
	dmesg | awk -v m="$MARK" 'seen; index($0, m) { seen = 1 }'
}

# insmod takes a file and nothing else, so what the module needs goes first.
load_stock() {
	local needs
	needs="$(modinfo -F depends "$STOCK" | tr ',' ' ')"
	# shellcheck disable=SC2086
	[ -z "$needs" ] || modprobe -a $needs
	insmod "$STOCK"
}

swap() {
	local want="$1" device=""
	echo "$MARK" >/dev/kmsg 2>/dev/null || true

	device="$(spi_device)"

	rmmod hid_magicmouse 2>/dev/null || true
	if [ -d /sys/module/hid_magicmouse ]; then
		echo "tactile-driver: the running driver is in use and could not be unloaded." >&2
		exit 1
	fi
	if [ "$want" = stock ]; then
		load_stock
	elif ! modprobe hid_magicmouse; then
		echo "tactile-driver: the driver did not load; putting the kernel's own back." >&2
		load_stock || true
		want=failed
	fi

	[ -z "$device" ] || rebind "$device"
	[ "$want" != failed ] || exit 1
}

reload() {
	need_root reload
	case "$(installed)" in
	*/updates/*) ;;
	*)
		echo "tactile-driver: Tactile's driver is not built for kernel $KERNEL." >&2
		echo "Check that the kernel's headers are installed, then: sudo dkms autoinstall" >&2
		command -v dkms >/dev/null 2>&1 && dkms status tactile >&2 || true
		exit 1
		;;
	esac
	swap tactile
	if [ "$(running)" != tactile ]; then
		echo "tactile-driver: the kernel's own driver loaded instead." >&2
		exit 1
	fi
	if ! systemctl is-active --quiet tactiled.service 2>/dev/null; then
		echo "Loaded. The trackpad's firmware plays the click until the service sets it up:"
		echo "  sudo systemctl enable --now tactiled"
		return
	fi

	# The service notices the new module within a few seconds and applies the
	# saved settings; the driver then takes the click once nothing touches
	# the pad.
	echo "Loaded. Waiting for the saved settings (keep your fingers off the trackpad)..."
	local log=""
	local i
	for i in $(seq 1 40); do
		sleep 0.5
		log="$(since_mark)"
		if grep -q -E "click feedback is host-driven|already host-controlled|cannot switch the actuator" <<<"$log"; then
			break
		fi
		# Set to let the firmware play the click: nothing to wait for.
		if [ "$(cat "$PARAMETERS/haptic_press" 2>/dev/null)" = N ] && [ "$i" -gt 12 ]; then
			break
		fi
	done
	if grep -q -E "click feedback is host-driven|already host-controlled" <<<"$log"; then
		echo "OK: the driver plays the click."
	elif grep -q "cannot switch the actuator" <<<"$log"; then
		echo "The trackpad refused to hand over the click. Lift your fingers and press \"Try again\" in Tactile." >&2
		exit 1
	else
		echo "OK: the driver is loaded; the trackpad's firmware plays the click (see: tactile status)."
	fi
}

stock() {
	need_root stock
	if [ -z "$STOCK" ]; then
		echo "tactile-driver: kernel $KERNEL has no hid-magicmouse of its own." >&2
		exit 1
	fi
	swap stock
	echo "OK: the kernel's own driver is loaded until the next boot; the trackpad's firmware plays the click."
}

repair() {
	need_root repair
	local device try i
	device="$(spi_device)"
	if [ -z "$device" ]; then
		echo "Nothing to do: the trackpad is not on the SPI controller here."
		return
	fi
	if has_actuator; then
		echo "OK: the actuator is there."
		return
	fi
	# A few tries and no more: every one pauses the keyboard for two seconds.
	for try in 1 2 3; do
		echo "The actuator is missing; probing the trackpad's controller again ($try/3)..."
		rebind "$device"
		for i in $(seq 1 20); do
			sleep 0.25
			if has_actuator; then
				echo "OK: the actuator is back. The driver takes the click once nothing touches the pad."
				return
			fi
		done
	done
	echo "tactile-driver: the actuator did not show up; the trackpad's firmware keeps playing the click." >&2
	exit 1
}

case "${1:-status}" in
status) status ;;
reload) reload ;;
stock) stock ;;
repair) repair ;;
-h | --help | help) sed -n '2,18s/^# \{0,1\}//p' "$0" ;;
*)
	echo "tactile-driver: unknown command \"$1\" (status, reload, stock, repair)" >&2
	exit 1
	;;
esac
