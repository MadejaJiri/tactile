[Unit]
Description=Tactile: find the trackpad's actuator if this boot missed it
Documentation=https://github.com/MadejaJiri/tactile
# A boot can come up without the trackpad's actuator (seen while Tactile was
# being developed, not since 0.2.1), and the driver then has nothing to play
# the click with. This looks once per boot and
# probes the controller again if so; it does nothing when the actuator is there.
#
# Off unless you enable it: on the one machine this was written on, probing
# the controller again once froze the whole system for four minutes.
Before=tactiled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tactile-driver repair

[Install]
WantedBy=multi-user.target
